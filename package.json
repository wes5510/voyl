{
	"name": "voyl",
	"private": true,
	"version": "1.0.0",
	"description": "Voyl Monorepo",
	"scripts": {
		"lint": "pnpm -r lint",
		"typecheck": "pnpm -r typecheck",
		"dev": "pnpm --filter @voyl/desktop dev",
		"build": "pnpm --filter @voyl/desktop build",
		"prepare": "husky",
		"pre-commit": "pnpm -r pre-commit"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"prettier": "^3.5.3",
		"typescript": "5.7.3",
		"eslint": "^9.26.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"electron",
			"esbuild",
			"unrs-resolver",
			"better-sqlite3"
		]
	}
}
