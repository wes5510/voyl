    "@types/micromatch": "^4.0.9",
    "@types/node": "^22.15.18",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@typescript-eslint/rule-tester": "^8.32.1",
    "@vitest/eslint-plugin": "^1.2.0",
    "eslint": "^9.26.0",
    "lint-staged": "^16.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.7.3",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "micromatch": "^4.0.8"
  }
