{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/models/*": ["src/renderer/src/models/*"],
      "@/common/*": ["src/renderer/src/common/*"],
      "@/pages/*": ["src/renderer/src/pages/*"],
    }
  }
}