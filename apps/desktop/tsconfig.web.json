{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/env.d.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/preload/*.d.ts",
    "src/common/**/*",
  ],
  "exclude": [
    "src/renderer/__common",
    "src/renderer/__models",
    "src/renderer/__pages"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/renderer/*": ["src/renderer/*"],
      "@/common/*": ["src/common/*"],
    }
  }
}